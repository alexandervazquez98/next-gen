# ==============================================================================
# NEX-GEN ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copia este archivo como '.env' y ajusta los valores segun tu entorno.
# NOTA IMPORTANTE: Si tus contraseñas contienen caracteres especiales como
# '#' o '"', DEBES envolver el valor en comillas simples (e.g., 'pass#123').

# --- DATABASE AUTH ---
# Usuario por defecto de Neo4j es 'neo4j'
NEO4J_USER=neo4j
NEO4J_PASSWORD='YourStrongPassword#2026'

POSTGRES_USER=nexgen_admin
POSTGRES_PASSWORD='YourStrongPassword#2026'
POSTGRES_DB=nexgen_auth

# --- POSTGRES NETWORKING ---
# Dentro de Docker Compose, los servicios se conectan a postgres:5432.
# Si necesitas publicar PostgreSQL en otro puerto del host, cambia solo
# POSTGRES_EXTERNAL_PORT. No uses POSTGRES_PORT=5433 con POSTGRES_HOST=postgres.
NEO4J_URI=bolt://neo4j:7687
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
POSTGRES_EXTERNAL_PORT=5432

# Host directory mounted into backend for PostgreSQL dumps.
BACKUP_DIR=.docker/backups

# --- SECURITY ---
# Genera una clave larga y aleatoria para produccion
JWT_SECRET_KEY='ChangeMe_SomethingVeryLongAndSecure_123456'
# Establece si las cookies de sesion deben ser solo HTTPS (True en prod, False en dev)
COOKIE_SECURE=false

# --- FRONTEND CONFIG ---
# URL del backend para que el frontend sepa a donde apuntar (Vite)
VITE_API_TARGET=http://backend:8000
# Origin del frontend para CORS (usar http://localhost:5173 en desarrollo)
FRONTEND_ORIGIN=http://localhost:5173

# --- ENGINE CONFIG ---
SNMP_DEFAULT_COMMUNITY=public
POLLING_CYCLE_SECONDS=10

# --- CLI CREDENTIALS ---
# Default credentials for CLI polling (SSH/Telnet to network devices)
CLI_DEFAULT_USER=
CLI_DEFAULT_PASS=
CLI_ENABLE_PASS=
