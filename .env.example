# ==============================================================================
# NEX-GEN ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copia este archivo como '.env' y ajusta los valores segun tu entorno.
# NOTA IMPORTANTE: Si tus contraseñas contienen caracteres especiales como
# '#' o '"', DEBES envolver el valor en comillas simples (e.g., 'pass#123').

# --- DATABASE AUTH ---
# Usuario por defecto de Neo4j es 'neo4j'
NEO4J_USER=neo4j
NEO4J_PASSWORD='YourStrongPassword#2026'

POSTGRES_USER=nexgen_admin
POSTGRES_PASSWORD='YourStrongPassword#2026'
POSTGRES_DB=nexgen_auth

# --- POSTGRES NETWORKING ---
# Dentro de Docker Compose, los servicios se conectan a postgres:5432.
# Si necesitas publicar PostgreSQL en otro puerto del host, cambia solo
# POSTGRES_EXTERNAL_PORT. No uses POSTGRES_PORT=5433 con POSTGRES_HOST=postgres.
NEO4J_URI=bolt://neo4j:7687
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
POSTGRES_EXTERNAL_PORT=5432

# Host directory mounted into backend for PostgreSQL dumps.
BACKUP_DIR=.docker/backups

# --- SECURITY ---
# Genera una clave larga y aleatoria para produccion
JWT_SECRET_KEY='ChangeMe_SomethingVeryLongAndSecure_123456'
# Establece si las cookies de sesion deben ser solo HTTPS (True en prod, False en dev)
COOKIE_SECURE=false

# --- TIME SYNCHRONIZATION VISIBILITY ---
# Containers inherit the host clock. TZ=UTC keeps display/config consistent, but
# it is not clock synchronization. Keep host NTP, chrony, or systemd-timesyncd
# healthy; see docs/time-sync-runbook.md.
TZ=UTC
TIME_SYNC_MODE=host
TIME_SYNC_WARNING_MS=1000
TIME_SYNC_CRITICAL_MS=5000
TIME_SYNC_QUERY_TIMEOUT_S=1

# --- FRONTEND CONFIG ---
# URL del backend para que el frontend sepa a donde apuntar (Vite)
VITE_API_TARGET=http://backend:8000
# Origin del frontend para CORS (usar http://localhost:5173 en desarrollo)
FRONTEND_ORIGIN=http://localhost:5173

# --- ENGINE CONFIG ---
SNMP_DEFAULT_COMMUNITY=public
POLLING_CYCLE_SECONDS=10
ICMP_LATENCY_WARNING_MS=100
ICMP_LATENCY_CRITICAL_MS=500

# Scalable polling pipeline PR1 flags/defaults (all behavior-changing flags default off)
POLLING_PIPELINE_OBSERVE_ONLY=false
POLLING_PG_QUEUE_ENABLED=false
POLLING_SNMP_LEASED_WORKER=false
POLLING_DB_WRITER_ENABLED=false
POLLING_BACKPRESSURE_ENABLED=false
POLLING_METADATA_CACHE_ENABLED=false
POLLING_TARGET_CYCLE_SECONDS=900
POLLING_WORKERS=8
POLLING_DB_WRITERS=1
POLLING_TASK_BATCH_SIZE=100
POLLING_RESULT_BATCH_SIZE=500
POLLING_BACKPRESSURE_MAX_TASK_QUEUE_DEPTH=100000
POLLING_BACKPRESSURE_MAX_WRITER_LAG_SECONDS=120
POLLING_BACKPRESSURE_RETRY_MAX_ATTEMPTS=5
POLLING_METADATA_CACHE_TTL_SECONDS=300
POLLING_BENCHMARK_CI_COUNT=8000
POLLING_BENCHMARK_METRICS_PER_CI=35
POLLING_BENCHMARK_DURATION_SECONDS=0
POLLING_BENCHMARK_PROTOCOL_MIX=ICMP:0.15,SNMP:0.55,CLI:0.15,REST:0.10,MQTT_STUB:0.05
POLLING_BENCHMARK_SINK=synthetic

# --- EVENT PRUNE / RECOVERY LIFECYCLE (fix-423) ---
# Auto-prune RECOVERED events that have been waiting for closure beyond
# `stale_after_seconds`. Runs on the in-process APScheduler (`backup_scheduler`)
# at `interval_seconds` cadence. Kill-switch for emergency disable.
# Defaults are safe for production: enabled, 1h tick, 500 events per batch,
# 1h stale threshold. After `safe-rebuild.sh --run-event-backfill` has run
# once the cursor is hardened and the scheduler can keep the RECOVERED set
# bounded without operator intervention.
EVENT_PRUNE_ENABLED=true
EVENT_PRUNE_INTERVAL_SECONDS=3600
EVENT_PRUNE_BATCH_SIZE=500
EVENT_PRUNE_STALE_AFTER_SECONDS=3600

# --- STALE EVENT REVIEW REMINDERS (Issue #154) ---
# Advisory-only surface for OPEN/ACK events lingering past their useful
# lifetime. Detects `COLLECTION_FAILURE` + `failure_family = SNMP_NO_RESPONSE`
# events via three reason codes (`older_than_threshold`, `no_refresh_in_window`,
# `link_missing`) and surfaces them at GET /api/events/recommendations. Three
# quick actions (`dismiss`/`snooze`/`escalate`) write audit rows only — they
# NEVER mutate the Event node. Kill-switch returns an empty list on GET and
# 503 on quick actions without code redeploy.
STALE_EVENT_REMINDER_ENABLED=true
STALE_EVENT_REMINDER_AGE_HOURS=24
STALE_EVENT_REMINDER_REFRESH_WINDOW_HOURS=6
STALE_EVENT_REMINDER_SNOOZE_TTL_HOURS=24

# --- LM STUDIO AI CHAT ---
# Enable only when LM Studio local server is running.
LM_STUDIO_ENABLED=false
# Use http://localhost:1234/v1 outside Docker. Inside Docker, prefer
# http://host.docker.internal:1234/v1 or a LAN IP for the host running LM Studio.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=local-model
# Backend caps completions to 1..4096 tokens. Docker/backend default: 800.
LM_STUDIO_MAX_TOKENS=800
LM_STUDIO_TIMEOUT_SECONDS=15

# --- AI PROMPTS (USER-OVERRIDABLE) ---
# Folder that holds the operator's copy of the AI prompt .md files.
# On first boot it is seeded from the bundled defaults and then frozen: edit
# freely, the app never overwrites your files. Leave empty to use the bundled
# prompts read-only (legacy behavior).
# Dev:    AI_PROMPTS_DIR=./.ai
# Docker: container path is /data/ai; set AI_PROMPTS_DIR_HOST to the host folder
#         mounted at that path (defaults to ./.docker/ai).
AI_PROMPTS_DIR=
AI_PROMPTS_DIR_HOST=.docker/ai

# --- CLI CREDENTIALS ---
# Default credentials for CLI polling (SSH/Telnet to network devices)
CLI_DEFAULT_USER=
CLI_DEFAULT_PASS=
CLI_ENABLE_PASS=
